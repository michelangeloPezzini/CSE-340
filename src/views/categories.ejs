<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>
    <h2>Service Project Categories</h2>
    <div class="tag-list">
        <% categories.forEach(category => { %>
            <a href="/category/<%= category.category_id %>" class="tag"><%= category.name %></a>
        <% }) %>
    </div>
    <% if (user && user.role_name === 'admin') { %>
        <p><a href="/new-category" class="btn-action">+ Add New Category</a></p>
    <% } %>
</main>
<%- include('partials/footer') %>
