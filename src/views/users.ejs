<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>

    <ul>
        <% users.forEach(user => { %>
            <li>
                <strong><%= user.name %></strong>
                &mdash; <%= user.email %>
                &mdash; <span class="tag"><%= user.role_name %></span>
            </li>
        <% }) %>
    </ul>
</main>
<%- include('partials/footer') %>
