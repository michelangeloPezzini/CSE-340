<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>

    <h2>Dashboard</h2>
    <p>Name: <%= name %></p>
    <p>Username: <%= email %></p>

    <section class="volunteer-section">
        <h3>My Volunteer Projects</h3>
        <% if (volunteerProjects && volunteerProjects.length > 0) { %>
            <ul class="volunteer-list">
                <% volunteerProjects.forEach(project => { %>
                    <li class="volunteer-item">
                        <div class="volunteer-info">
                            <a href="/project/<%= project.project_id %>"><strong><%= project.title %></strong></a>
                            <span class="muted"><%= new Date(project.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' }) %> &mdash; <%= project.location %></span>
                        </div>
                        <form action="/project/<%= project.project_id %>/remove-volunteer" method="POST" style="display:inline;">
                            <button type="submit" class="btn-remove">Remove</button>
                        </form>
                    </li>
                <% }) %>
            </ul>
        <% } else { %>
            <p><em>You have not signed up for any projects yet. <a href="/projects">Browse projects</a> to get started.</em></p>
        <% } %>
    </section>

    <% if (user && user.role_name === 'admin') { %>
        <div class="page-actions">
            <a href="/users" class="btn-action">View All Users</a>
        </div>
    <% } %>
</main>
<%- include('partials/footer') %>
